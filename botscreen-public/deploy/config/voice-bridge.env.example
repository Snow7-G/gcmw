# EnvironmentFile for qa-server.service (the voice bridge on 8000).
#
# Copy to the path in @@GCMW_CONFIG_DIR@@/voice-bridge.env, then `chmod 600`.
# The bridge REFUSES TO START on a bad value — it never silently falls back to
# the legacy model, so a typo here is a startup failure, not a wrong answer.

# legacy | agent   (default: legacy)
#   agent — answers come from the Agent API, with citations and a support gate
GCMW_VOICE_ANSWER_BACKEND=agent

# MUST be exactly this string. The adapter accepts no other value, by contract:
# a different host/port/path means the voice bridge is not talking to the
# pinned local Agent API, and that is refused at startup rather than trusted.
GCMW_VOICE_AGENT_API_BASE=http://127.0.0.1:8001/api/v1

# Device credential for the Agent API. Three distinct values are rejected at
# startup: missing, empty, and the literal placeholder below. Keep the real
# value in this 600-mode file only.
GCMW_VOICE_AGENT_CREDENTIAL=YOUR_DEMO_CREDENTIAL_HERE

# Knowledge base document used by the LEGACY backend (/chat without agent mode).
# Irrelevant when GCMW_VOICE_ANSWER_BACKEND=agent, but harmless to leave set.
KB_DOCX_PATH=/opt/gcmw/config/knowledge-base.docx

# Legacy backend only: DeepSeek key, read solely by the legacy path. Leaving it
# unset is fine in agent mode — and agent mode NEVER falls back to it.
# DEEPSEEK_API_KEY=<set-me-outside-the-repo>
