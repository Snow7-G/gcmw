# EnvironmentFile for gcmw-agent-demo.service (the demo Agent API on 8001).
#
# Copy to the path in @@GCMW_CONFIG_DIR@@/demo-agent-api.env, then `chmod 600`.
# This file is the ONLY place credentials may live: never in a unit file, never
# in the repository, never in a shell command line.
#
# OMIT THIS FILE ENTIRELY to run the offline demo (MockProvider, zero network).
# That is the default and the recommended mode when the venue network is
# unknown.

# mock | cloud | local   (default: mock)
#   mock  — offline canned replies; every answer still passes the evidence gate
#   cloud — a real model provider; REQUIRES a reachable network and an API key
GCMW_ACTIVE_PROVIDER=mock

# Name of the variable that holds the provider key. Only consulted when
# GCMW_ACTIVE_PROVIDER=cloud; the value itself must be a REAL secret and this
# file must stay mode 600. Left unset here on purpose — a key must never be
# committed.
# GCMW_CLOUD_API_KEY=<set-me-outside-the-repo>

# Optional: rename the key variable (e.g. to share one secret with another
# service). Defaults to GCMW_CLOUD_API_KEY.
# GCMW_CLOUD_API_KEY_ENV=<variable-name>
