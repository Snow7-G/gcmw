# Copy to .env and fill locally. Never commit .env.
GCMW_ENV=development
GCMW_DEBUG=0
GCMW_ACTIVE_PROVIDER=mock

# Cloud provider (development/test only; must not receive real patient data)
GCMW_CLOUD_PROVIDER=dashscope_realtime
GCMW_CLOUD_ADAPTER=cloud_realtime
GCMW_CLOUD_MODEL=qwen3.5-omni-plus-realtime
GCMW_CLOUD_API_BASE=https://dashscope.aliyuncs.com/api/v1
GCMW_CLOUD_API_KEY_ENV=GCMW_CLOUD_API_KEY
# GCMW_CLOUD_API_KEY=set-via-secret-manager
GCMW_CLOUD_MODALITIES=text,audio,image,video
GCMW_CLOUD_TIMEOUT_MS=15000
GCMW_CLOUD_CONNECT_TIMEOUT_MS=5000

# Local Omni provider
GCMW_LOCAL_PROVIDER=vllm
GCMW_LOCAL_ADAPTER=local_omni
GCMW_LOCAL_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct
GCMW_LOCAL_API_BASE=http://127.0.0.1:8001/v1
GCMW_LOCAL_MODALITIES=text,audio,image,video
GCMW_LOCAL_TIMEOUT_MS=30000
GCMW_LOCAL_CONNECT_TIMEOUT_MS=5000

# Storage
# Device credentials for the agent API (issue #66): a JSON list, never a
# committed secret. Shape:
#   [{"tenant_id": "<tenant>", "device_id": "<device>", "token": "<random>"}]
# The application keeps SHA-256 digests only. An empty list is DEFAULT DENY
# (every API call answers 401); staging/production refuse to start without it.
GCMW_DEVICE_CREDENTIALS=[]
# Environment variable consulted for the list above (name only):
GCMW_AUTH_CREDENTIALS_ENV=GCMW_DEVICE_CREDENTIALS

# Request rate limits (#66): requests per minute per scope; 0 disables a scope.
# Counters are process-local (a multi-worker deployment needs the persistent
# store tracked by #65).
GCMW_RATE_LIMIT_TENANT_PER_MINUTE=600
GCMW_RATE_LIMIT_DEVICE_PER_MINUTE=300
GCMW_RATE_LIMIT_SESSION_PER_MINUTE=120

GCMW_REDIS_URL=redis://127.0.0.1:6379/0
GCMW_DATABASE_URL=postgresql://gcmw:gcmw@127.0.0.1:5432/gcmw
GCMW_VECTOR_DATABASE_URL=

# Run limits
GCMW_RUN_TIMEOUT_MS=15000
GCMW_ANSWER_TOKEN_BUDGET=400
GCMW_MAX_TOOL_CALLS=4
GCMW_MAX_AGENT_HANDOFFS=2
GCMW_MAX_REVISIONS=1

# Separate timeouts
GCMW_MODEL_TIMEOUT_MS=15000
GCMW_TOOL_TIMEOUT_MS=5000
GCMW_SSE_TIMEOUT_MS=30000
